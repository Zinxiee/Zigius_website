---
import '@fontsource-variable/inter';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* Deepened Peach/Coral for readability on light backgrounds */
    --aw-color-primary: rgb(218 105 105); 
    --aw-color-secondary: rgb(198 85 85); 
    /* Deepened Mint for contrast */
    --aw-color-accent: rgb(90 190 165); 

    /* Darkened text for stronger contrast */
    --aw-color-text-heading: rgb(33 33 33);
    --aw-color-text-default: rgb(55 55 55);
    --aw-color-text-muted: rgb(99 99 99);
    --aw-color-bg-page: rgb(253 252 251); 

    --aw-color-bg-page-dark: rgb(23 25 35);

    ::selection {
      background-color: rgb(152 226 208 / 40%); 
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* True soft pastels work perfectly on dark backgrounds */
    --aw-color-primary: rgb(255 163 163); 
    --aw-color-secondary: rgb(255 138 138); 
    --aw-color-accent: rgb(152 226 208); 

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(160 174 192);
    --aw-color-bg-page: rgb(26 32 44); 

    ::selection {
      background-color: rgb(255 163 163 / 30%);
      color: snow;
    }
  }
</style>