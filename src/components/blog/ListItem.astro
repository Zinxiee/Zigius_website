---
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = (await findImage(post.image)) as ImageMetadata | undefined;

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article
  class={`relative max-w-md mx-auto md:max-w-none grid gap-5 md:gap-8 rounded-[2rem] border border-rose-200/70 dark:border-teal-800/40 bg-gradient-to-r from-white/80 via-rose-50/50 to-teal-50/60 dark:from-slate-900/85 dark:via-slate-900/80 dark:to-teal-950/40 backdrop-blur-md p-4 sm:p-5 shadow-[0_18px_50px_rgba(218,105,105,0.12)] hover:shadow-[0_20px_60px_rgba(90,190,165,0.22)] transition-all duration-300 group ${image ? 'md:grid-cols-2' : ''}`}
>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-1.5 rounded-t-[2rem] bg-gradient-to-r from-primary via-accent to-secondary"></div>
  
  {
    image &&
      (link ? (
        <a class="relative block" href={link ?? 'javascript:void(0)'}>
          <div class="relative h-52 sm:h-60 md:h-72 overflow-hidden rounded-[1.5rem] bg-gradient-to-br from-rose-200/70 via-amber-100/60 to-teal-200/70 shadow-md ring-1 ring-rose-300/30 dark:from-rose-950/50 dark:via-slate-800 dark:to-teal-900/50 dark:ring-white/10 transition-transform duration-500 group-hover:scale-[1.01]">
            {image && (
              <Image
                src={image}
                class="absolute inset-0 object-contain w-full h-full mb-6 rounded-[1.5rem]"
                style="object-fit: contain; object-position: center;"
                widths={[400, 900]}
                width={900}
                height={506}
                sizes="(max-width: 900px) 400px, 900px"
                alt={post.title}
                format="webp"
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
        </a>
      ) : (
        <div class="relative h-52 sm:h-60 md:h-72 overflow-hidden rounded-[1.5rem] bg-gradient-to-br from-rose-200/70 via-amber-100/60 to-teal-200/70 shadow-md ring-1 ring-rose-300/30 dark:from-rose-950/50 dark:via-slate-800 dark:to-teal-900/50 dark:ring-white/10">
          {image && (
            <Image
              src={image}
              class="absolute inset-0 object-contain w-full h-full mb-6 rounded-[1.5rem]"
              style="object-fit: contain; object-position: center;"
              widths={[400, 900]}
              width={900}
              height={506}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.title}
              format="webp"
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
      ))
  }
  <div class="mt-1 sm:mt-2">
    <header class="space-y-3">
      <div class="flex flex-wrap items-center gap-2 text-xs sm:text-sm">
        <span class="inline-flex items-center gap-1 rounded-full bg-teal-100/90 text-teal-900 px-3 py-1 font-medium shadow-xs dark:bg-teal-900/50 dark:text-teal-200">
          <Icon name="tabler:clock" class="h-3.5 w-3.5" />
          <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
        </span>
        {
          post.author && (
            <span class="inline-flex items-center gap-1 rounded-full bg-amber-100/90 text-amber-900 px-3 py-1 font-medium shadow-xs dark:bg-amber-900/40 dark:text-amber-200">
              <Icon name="tabler:user" class="h-3.5 w-3.5" />
              <span>{post.author.replaceAll('-', ' ')}</span>
            </span>
          )
        }
        {
          post.category && (
            <a
              class="inline-flex items-center rounded-full bg-rose-200/90 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-rose-900 shadow-xs transition-colors hover:bg-rose-300 dark:bg-rose-900/60 dark:text-rose-200 dark:hover:bg-rose-900/80"
              href={getPermalink(post.category.slug, 'category')}
            >
              {post.category.title}
            </a>
          )
        }
      </div>
      <h2 class="text-xl sm:text-2xl font-bold leading-tight font-heading dark:text-slate-200">
        {
          link ? (
            <a class="inline-block transition ease-in duration-200 hover:text-primary dark:hover:text-accent" href={link}>
              {post.title}
            </a>
          ) : (
            post.title
          )
        }
      </h2>
    </header>

    {post.excerpt && <p class="mt-3 text-base sm:text-lg leading-7 text-muted dark:text-slate-300">{post.excerpt}</p>}
    {
      post.tags && Array.isArray(post.tags) ? (
        <footer class="mt-4 sm:mt-5">
          <PostTags tags={post.tags} />
        </footer>
      ) : (
        <Fragment />
      )
    }
  </div>
</article>