---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';

import HeroImg1 from '~/assets/images/Switzerland-pic.jpg';
import HeroImg2 from '~/assets/images/ballpit_inv.jpg';
import Hisc from '~/assets/images/ATE Poster.png';
import Polle from '~/assets/images/POLL_E.jpg';
import Rubiks from '~/assets/images/rubiks.jpg';
import Astra from '~/assets/images/ASTRA.jpg';
import Torquey from '~/assets/images/torquey.jpg';
import Diss from '~/assets/images/dissertation.jpg';
import Zachai from '~/assets/images/zachai.jpeg';
import Dora from '~/assets/images/dora.jpg';
import Tsmc from '~/assets/images/tsmc.jpg';
import TaiwanMinistry from '~/assets/images/taiwan_ministry.jpg';
import Youth from '~/assets/images/youth.jpg';

const displayName = 'Zachary Lucius Danzig';
const emailAddress = 'ZachDanzig@gmail.com';
const linkedinUrl = 'https://www.linkedin.com/in/zachary-danzig/';

const metadata = {
  title: 'Zigius · The Domain of Zach',
  description: 'Personal portfolio for Zigius, with selected projects, contact details, and a polished showcase of work.',
};

const heroImage = `
  <div class="relative mx-auto w-full max-w-5xl">
    <div class="absolute -inset-8 rounded-[2.5rem] bg-gradient-to-r from-cyan-400/20 via-fuchsia-400/20 to-amber-400/20 blur-3xl"></div>
    <div class="relative grid gap-4 md:grid-cols-[1.1fr_0.9fr]">
      <img
        src="${HeroImg1.src}"
        alt="${displayName} portrait Image"
        class="h-[420px] w-full rounded-[2rem] object-cover shadow-2xl ring-1 ring-white/10"
      />
      <div class="grid gap-4">
        <img
          src="${HeroImg2.src}"
          alt="${displayName} ballpit Image"
          class="h-[204px] w-full rounded-[1.75rem] object-cover shadow-2xl ring-1 ring-white/10"
        />
        <div class="rounded-[1.75rem] border border-white/10 bg-slate-950/80 p-6 text-left text-white shadow-2xl backdrop-blur">
          <p class="text-xs uppercase tracking-[0.3em] text-cyan-300">Zachary Lucius Danzig</p>
          <p class="mt-3 text-2xl font-semibold">Robotics, Mechatronics, and Control Engineering Graduate</p>
          <p class="mt-2 text-sm text-white/70">
            Seeking opportunities to apply my innovative thinking and hardworking nature to make the world a better place!
          </p>
        </div>
      </div>
    </div>
  </div>
`;

const projects = [
  {
    title: 'Robotic Object Recognition for Thousand Brains Systems',
    summary: 'My Undergraduate Dissertation, partnered with the Thousand Brains Project',
    role: 'Sole Developer',
    stack: 'Python, Machine Vision, Inverse Kinematics, Stereo Vision, ToF',
    href: '<INPUT_PROJECT_4_LINK>',
    image: Diss.src,
  },
  {
    title: 'Torque of The Town',
    summary: 'TBA.... built from scratch.',
    role: 'Team Lead',
    stack: 'Arduino, Python, Machine Vision, Inverse Kinematics',
    href: 'https://github.com/Zinxiee/Torque_of_the_Town',
    image: Torquey.src,
  },
  {
    title: 'A.S.T.R.A',
    summary: 'Autonomous Stacker Tracker Robot Arm',
    role: 'Team Lead',
    stack: 'Python, Machine Vision, ROS',
    href: 'https://www.linkedin.com/posts/zachary-danzig_robotics-ai-machinevision-activity-7216731826592055297-xNEt',
    image: Astra.src,
  },
  {
    title: 'A.D.S.T.A',
    summary: 'Augmented Display Speech-to-Text Assistant',
    role: 'Sole Developer',
    stack: 'Python',
    href: '<INPUT_PROJECT_1_LINK>',
    image: '<INPUT_PROJECT_1_IMAGE>',
  },
  {
    title: 'ZachAI',
    summary: 'A quirky email daemon that can respond to a variety of queries, from cryptic crossword generation to random xkcd comics, ZachAI has it all (almost)',
    role: 'Sole Developer',
    stack: 'Python',
    href: '<INPUT_PROJECT_3_LINK>',
    image: Zachai.src,
  },
  {
    title: 'Rubikinators',
    summary: 'Rubik\'s Cube Solver',
    role: 'Sole Developer',
    stack: 'Python, Machine Vision',
    href: 'https://github.com/Zinxiee/Rubikinators',
    image: Rubiks.src,
  },
  {
    title: 'Hexicon',
    summary: 'A new language based on colours!',
    role: 'Sole Developer',
    stack: 'Python',
    href: '<INPUT_PROJECT_4_LINK>',
    image: '<INPUT_PROJECT_4_IMAGE>',
  },
  {
    title: 'CRATE - Capgemini Reusable Automated Test Equipment',
    summary: 'Affordable test equipment for hard real-time systems. Built during my placement year at Capgemini Engineering.',
    role: 'Intern - Mechatronics Engineer',
    stack: 'Microcontrollers',
    href: 'https://www.linkedin.com/posts/zachary-danzig_hisc2025-activity-7410741170147991552-QxI3',
    image: Hisc.src,
  },
  {
    title: 'D.O.R.A',
    summary: 'Directional Orienteering Retrieval Android. Winning team!',
    role: 'Software Engineer, communications',
    stack: 'Arduino, Python',
    href: 'https://www.linkedin.com/posts/zachary-danzig_robotics-engineering-loughboroughuniversity-activity-7211353275671928834-cuGu',
    image: Dora.src,
  },
  {
    title: 'POLL-E',
    summary: 'Autonomous Bus System Prototype, partnered with Oxa (previously Oxbotica)',
    role: 'Team Lead',
    stack: 'Arduino',
    href: 'https://www.linkedin.com/posts/zachary-danzig_autonomousvehicles-autonomoussystems-oxa-activity-7086079868353798144-qexa',
    image: Polle.src,
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <Hero
    id="hero"
    actions={[
      {
        text: 'Email',
        href: `mailto:${emailAddress}`,
      },
      {
        variant: 'primary',
        text: 'LinkedIn',
        href: linkedinUrl,
        target: '_blank',
        rel: 'noreferrer',
      },
      { text: 'Projects', href: '#projects' },
    ]}
    image={heroImage}
  >
    <Fragment slot="tagline">Portfolio of {displayName}</Fragment>
    <Fragment slot="title">
      Zigius · <span class="text-accent dark:text-white">Domain of Zach</span>
    </Fragment>
    <Fragment slot="subtitle">
      Hello and welcome to <span class="font-semibold">Zigius</span>! I'm Zach and this is my website.<br />
      Scroll to see some of the projects I've worked on and find out a bit more about me!
    </Fragment>
  </Hero>

  <section id="about" class="relative not-prose">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute left-1/2 top-0 h-72 w-72 -translate-x-1/2 rounded-full bg-cyan-300/10 blur-3xl"></div>
      <div class="absolute right-0 top-24 h-64 w-64 rounded-full bg-fuchsia-400/10 blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-16">
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] items-start intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-secondary">About</p>
          <h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight dark:text-white">Zachary Lucius<br />Danzig</h2>
        </div>
        <div class="space-y-4 text-lg text-muted dark:text-slate-300">
          <p>
            I'm a recent graduate from Loughborough University. Achieving a First Class Honours in Robotics, Mechatronics, and Control Engineering.<br />
            I'm deeply interested in the implementation of contemporary neuroscience research in artificially intelligent systems.<br /><br />
            My undergraduate dissertation was on Robotic Object Recognition for Thousand Brains Systems, in collaboration with the Thousand Brains Project.<br />
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="projects" class="relative not-prose">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-16">
      <div class="flex items-end justify-between gap-6 mb-8 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-secondary">Projects</p>
          <h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight dark:text-white">Projects I've worked on</h2>
        </div>
        <p class="hidden md:block max-w-xl text-muted dark:text-slate-300">
          Check out some of the projects I've worked on. Some are in teams and some I've tackled alone! 🤖
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {
          projects.map((project, index) => (
            <article class="group overflow-hidden rounded-[2rem] border border-slate-200/70 bg-white/80 shadow-[0_20px_80px_-40px_rgba(15,23,42,0.35)] backdrop-blur transition duration-500 hover:-translate-y-1 hover:shadow-[0_30px_100px_-40px_rgba(15,23,42,0.45)] dark:border-slate-700 dark:bg-slate-900/70 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
              <a href={project.href} target="_blank" rel="noreferrer" class="block h-full">
                <div class="relative aspect-[16/10] overflow-hidden bg-slate-950">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/10 to-transparent"></div>
                  <div class="absolute left-5 top-5 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.25em] text-white backdrop-blur">
                    Project {String(index + 1).padStart(2, '0')}
                  </div>
                </div>
                <div class="p-6 md:p-8">
                  <div class="flex items-start justify-between gap-4">
                    <h3 class="text-2xl font-bold tracking-tight dark:text-white">{project.title}</h3>
                    <span class="text-sm font-medium text-secondary whitespace-nowrap">View project</span>
                  </div>
                  <p class="mt-4 text-muted dark:text-slate-300">{project.summary}</p>
                  <dl class="mt-6 grid gap-4 sm:grid-cols-2 text-sm">
                    <div>
                      <dt class="font-semibold uppercase tracking-[0.22em] text-slate-500 dark:text-slate-400">Role</dt>
                      <dd class="mt-2 text-slate-800 dark:text-slate-200">{project.role}</dd>
                    </div>
                    <div>
                      <dt class="font-semibold uppercase tracking-[0.22em] text-slate-500 dark:text-slate-400">Stack</dt>
                      <dd class="mt-2 text-slate-800 dark:text-slate-200">{project.stack}</dd>
                    </div>
                  </dl>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="taiwan" class="relative not-prose overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute left-0 top-10 h-72 w-72 rounded-full bg-pink-500/20 blur-3xl"></div>
      <div class="absolute right-0 bottom-10 h-80 w-80 rounded-full bg-cyan-400/20 blur-3xl"></div>
      <div class="absolute inset-x-0 top-1/2 h-24 -translate-y-1/2 bg-gradient-to-r from-fuchsia-500/10 via-amber-400/10 to-cyan-400/10"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-16">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] items-center rounded-[2.5rem] border border-white/10 bg-slate-950/90 p-6 md:p-10 shadow-[0_30px_120px_-50px_rgba(236,72,153,0.6)]">
        <div class="space-y-4 text-white">
          <p class="text-sm font-semibold uppercase tracking-[0.35em] text-cyan-300">Taiwan Skills Exchange</p>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Understanding Taiwan's role in the Global Semiconductor Supply Chain</h2>
          <p class="text-base md:text-lg text-white/80">
            In 2026, I was selected as one of ten UK students to visit Taiwan and learn about their semiconductor industry as part of a UK-Taiwan international relations trip, arranged by the UK government alongside the UK Electronics Skills Foundation and SEMI Taiwan.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="group overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 shadow-2xl transition duration-500 hover:-translate-y-1">
            <img
              src={TaiwanMinistry.src}
              alt="Taiwan trip photo 1"
              class="h-100 w-full object-cover transition duration-700 group-hover:scale-160"
            />
          </div>
          <div class="group overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 shadow-2xl transition duration-500 hover:-translate-y-1 sm:mt-20">
            <img
              src={Tsmc.src}
              alt="Taiwan trip photo 2"
              class="h-80 w-full object-cover transition duration-700 group-hover:scale-110"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="relative not-prose">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute left-0 top-12 h-72 w-72 rounded-full bg-rose-300/20 blur-3xl"></div>
      <div class="absolute right-8 bottom-0 h-80 w-80 rounded-full bg-cyan-300/20 blur-3xl"></div>
      <div class="absolute inset-x-0 top-1/2 h-24 -translate-y-1/2 bg-gradient-to-r from-rose-200/40 via-amber-200/40 to-cyan-200/40"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-16">
      <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] items-stretch rounded-[2.5rem] border border-rose-100/80 bg-gradient-to-br from-rose-50 via-amber-50 to-cyan-50 p-6 md:p-10 shadow-[0_30px_120px_-60px_rgba(244,114,182,0.55)]">
        <div class="flex flex-col justify-between gap-6 rounded-[2rem] bg-white/70 p-6 md:p-8 shadow-inner backdrop-blur">
          <div class="space-y-4">
            <p class="text-sm font-semibold uppercase tracking-[0.35em] text-rose-500">Contact</p>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900">Always learning. Always curious.</h2>
            <p class="max-w-xl text-base md:text-lg text-slate-600">
              Reach out to me through the links below 🚀 
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-13">
            <a
              href={`mailto:${emailAddress}`}
              class="inline-flex items-center justify-center rounded-full border border-slate-300 bg-white/800 px-6 py-3 text-sm font-semibold text-slate-900 shadow-lg shadow-slate-900/10 transition duration-300 hover:-translate-y-0.5 hover:border-rose-300 hover:bg-rose-50"
            >
              Email
            </a>
            <a
              href={linkedinUrl}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center justify-center rounded-full bg-rose-900 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-slate-900/20 transition duration-300 hover:-translate-y-0.5 hover:bg-slate-800"
            >
              LinkedIn
            </a>
          </div>

          <dl class="grid gap-4 sm:grid-cols-3 text-sm text-slate-700">
            <div class="rounded-2xl bg-white/80 p-4 ring-1 ring-slate-200/80">
              <dt class="font-semibold uppercase tracking-[0.22em] text-slate-500">Email</dt>
              <dd class="mt-2 break-all text-base text-slate-900">{emailAddress}</dd>
            </div>
            <div class="rounded-2xl bg-white/80 p-4 ring-1 ring-slate-200/80">
              <dt class="font-semibold uppercase tracking-[0.22em] text-slate-500">LinkedIn</dt>
              <dd class="mt-2 text-base text-slate-900">Zachary Danzig</dd>
            </div>
          </dl>
        </div>

        <div class="group relative overflow-hidden rounded-[2rem] border border-white/70 bg-white/60 shadow-[0_25px_80px_-40px_rgba(15,23,42,0.35)]">
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/55 via-slate-950/10 to-transparent"></div>
          <img
            src={Youth.src}
            alt="Young Zach portrait"
            class="h-full min-h-[360px] w-full object-cover object-center transition duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-x-0 bottom-0 p-5 md:p-6">
            <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/15 px-4 py-2 text-xs font-semibold uppercase tracking-[0.25em] text-white backdrop-blur">
              Mini Me!
            </div>
            <p class="mt-4 max-w-md text-sm md:text-base text-white/85">
              
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
