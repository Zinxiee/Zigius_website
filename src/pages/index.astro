---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const displayName = 'Zachary Lucius Danzig';
const emailAddress = 'Zachdanzig@gmail.com';
const linkedinUrl = 'https://www.linkedin.com/in/zachary-danzig/';

const metadata = {
  title: 'Zigius - The Domain of Zach',
  description: 'Personal portfolio for Zigius, with selected projects, contact details, and a polished showcase of work.',
};

const heroImage = `
  <div class="relative mx-auto w-full max-w-5xl">
    <div class="absolute -inset-8 rounded-[2.5rem] bg-gradient-to-r from-cyan-400/20 via-fuchsia-400/20 to-amber-400/20 blur-3xl"></div>
    <div class="relative grid gap-4 md:grid-cols-[1.1fr_0.9fr]">
      <img
        src="<INPUT_HERO_IMAGE_1>"
        alt="${displayName} portrait placeholder 1"
        class="h-[420px] w-full rounded-[2rem] object-cover shadow-2xl ring-1 ring-white/10"
      />
      <div class="grid gap-4">
        <img
          src="<INPUT_HERO_IMAGE_2>"
          alt="${displayName} portrait placeholder 2"
          class="h-[204px] w-full rounded-[1.75rem] object-cover shadow-2xl ring-1 ring-white/10"
        />
        <div class="rounded-[1.75rem] border border-white/10 bg-slate-950/80 p-6 text-left text-white shadow-2xl backdrop-blur">
          <p class="text-xs uppercase tracking-[0.3em] text-cyan-300">Portfolio placeholder</p>
          <p class="mt-3 text-2xl font-semibold">Replace this with your role, location, or current focus.</p>
          <p class="mt-2 text-sm text-white/70">
            Add one short line about the kind of work you want more of, or the kinds of teams you want to work with.
          </p>
        </div>
      </div>
    </div>
  </div>
`;

const projects = [
  {
    title: '<INPUT_PROJECT_1_TITLE>',
    summary: '<INPUT_PROJECT_1_SUMMARY>',
    role: '<INPUT_PROJECT_1_ROLE>',
    stack: '<INPUT_PROJECT_1_STACK>',
    href: '<INPUT_PROJECT_1_LINK>',
    image: '<INPUT_PROJECT_1_IMAGE>',
  },
  {
    title: '<INPUT_PROJECT_2_TITLE>',
    summary: '<INPUT_PROJECT_2_SUMMARY>',
    role: '<INPUT_PROJECT_2_ROLE>',
    stack: '<INPUT_PROJECT_2_STACK>',
    href: '<INPUT_PROJECT_2_LINK>',
    image: '<INPUT_PROJECT_2_IMAGE>',
  },
  {
    title: '<INPUT_PROJECT_3_TITLE>',
    summary: '<INPUT_PROJECT_3_SUMMARY>',
    role: '<INPUT_PROJECT_3_ROLE>',
    stack: '<INPUT_PROJECT_3_STACK>',
    href: '<INPUT_PROJECT_3_LINK>',
    image: '<INPUT_PROJECT_3_IMAGE>',
  },
  {
    title: '<INPUT_PROJECT_4_TITLE>',
    summary: '<INPUT_PROJECT_4_SUMMARY>',
    role: '<INPUT_PROJECT_4_ROLE>',
    stack: '<INPUT_PROJECT_4_STACK>',
    href: '<INPUT_PROJECT_4_LINK>',
    image: '<INPUT_PROJECT_4_IMAGE>',
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <Hero
    id="hero"
    actions={[
      {
        variant: 'primary',
        text: 'LinkedIn',
        href: linkedinUrl,
        target: '_blank',
        rel: 'noreferrer',
      },
      {
        text: 'Email me',
        href: `mailto:${emailAddress}`,
      },
      { text: 'Projects', href: '#projects' },
    ]}
    image={heroImage}
  >
    <Fragment slot="tagline">Portfolio of {displayName}</Fragment>
    <Fragment slot="title">
      Zigius · <span class="text-accent dark:text-white">Domain of Zach</span>
    </Fragment>
    <Fragment slot="subtitle">
      Hello and welcome to <span class="font-semibold">Zigius</span>! I'm Zach and this is my domain. 
      Scroll to see some of the projects I've worked on and find out a bit more about me!
    </Fragment>
  </Hero>

  <section id="about" class="relative not-prose">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute left-1/2 top-0 h-72 w-72 -translate-x-1/2 rounded-full bg-cyan-300/10 blur-3xl"></div>
      <div class="absolute right-0 top-24 h-64 w-64 rounded-full bg-fuchsia-400/10 blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-16">
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] items-start intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-secondary">About</p>
          <h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight dark:text-white">A focused, personal presentation</h2>
        </div>
        <div class="space-y-4 text-lg text-muted dark:text-slate-300">
          <p>
            {'<INPUT_SHORT_BIO>'}
          </p>
          <p>
            Use this section to explain what you do, what you care about, and what kinds of projects you want more of.
          </p>
          <div class="flex flex-wrap gap-3 pt-2 text-sm font-medium">
            <span class="rounded-full border border-slate-200 bg-white px-4 py-2 text-slate-700 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">Portfolio</span>
            <span class="rounded-full border border-slate-200 bg-white px-4 py-2 text-slate-700 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">Selected work</span>
            <span class="rounded-full border border-slate-200 bg-white px-4 py-2 text-slate-700 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">Direct contact</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="projects" class="relative not-prose">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-16">
      <div class="flex items-end justify-between gap-6 mb-8 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-secondary">Projects</p>
          <h2 class="mt-3 text-3xl md:text-4xl font-bold tracking-tight dark:text-white">Four featured projects</h2>
        </div>
        <p class="hidden md:block max-w-xl text-muted dark:text-slate-300">
          Each project card includes placeholders for title, summary, role, stack, image, and link so you can fill in the
          details quickly.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {
          projects.map((project, index) => (
            <article class="group overflow-hidden rounded-[2rem] border border-slate-200/70 bg-white/80 shadow-[0_20px_80px_-40px_rgba(15,23,42,0.35)] backdrop-blur transition duration-500 hover:-translate-y-1 hover:shadow-[0_30px_100px_-40px_rgba(15,23,42,0.45)] dark:border-slate-700 dark:bg-slate-900/70 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
              <a href={project.href} target="_blank" rel="noreferrer" class="block h-full">
                <div class="relative aspect-[16/10] overflow-hidden bg-slate-950">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/10 to-transparent"></div>
                  <div class="absolute left-5 top-5 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.25em] text-white backdrop-blur">
                    Project {String(index + 1).padStart(2, '0')}
                  </div>
                </div>
                <div class="p-6 md:p-8">
                  <div class="flex items-start justify-between gap-4">
                    <h3 class="text-2xl font-bold tracking-tight dark:text-white">{project.title}</h3>
                    <span class="text-sm font-medium text-secondary whitespace-nowrap">View project</span>
                  </div>
                  <p class="mt-4 text-muted dark:text-slate-300">{project.summary}</p>
                  <dl class="mt-6 grid gap-4 sm:grid-cols-2 text-sm">
                    <div>
                      <dt class="font-semibold uppercase tracking-[0.22em] text-slate-500 dark:text-slate-400">Role</dt>
                      <dd class="mt-2 text-slate-800 dark:text-slate-200">{project.role}</dd>
                    </div>
                    <div>
                      <dt class="font-semibold uppercase tracking-[0.22em] text-slate-500 dark:text-slate-400">Stack</dt>
                      <dd class="mt-2 text-slate-800 dark:text-slate-200">{project.stack}</dd>
                    </div>
                  </dl>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contact" class="relative not-prose">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-16">
      <CallToAction
        title="Let's build the next thing together"
        subtitle="Replace these placeholders with your real contact details, then use this section as the final prompt to get in touch."
        actions={[
          {
            variant: 'primary',
            text: 'LinkedIn',
            href: linkedinUrl,
            target: '_blank',
            rel: 'noreferrer',
          },
          {
            text: 'Email',
            href: `mailto:${emailAddress}`,
          },
        ]}
      />
    </div>
  </section>
</Layout>
