---
import Layout from '~/layouts/Layout.astro';
import { getHomePermalink } from '~/utils/permalinks';
import Capy from '~/assets/images/capy.png';

const title = `Error 404`;
---

<Layout metadata={{ title }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h2 class="mb-8 font-bold text-9xl">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h2>
        <p class="text-3xl font-semibold md:text-3xl">Whoopsies! Looks like this link is on it's lunch break 🦖</p>
        <p class="mt-2 mb-8 text-lg text-muted dark:text-slate-400">
          Maybe hang around? I'm sure the link will come back eventually.
        </p>
        <img
          src={Capy.src}
          alt="${displayName} portrait Image"
          class="h-[420px] w-full rounded-[2rem] object-cover shadow-2xl ring-1 ring-white/10"
        />
        <a rel="noopener noreferrer" href={getHomePermalink()} class="btn mt-8">Back to homepage</a>
      </div>
    </div>
  </section>
</Layout>
